rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the authenticated user has a 'teacher' role or is an admin/creator
    function isTeacher() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['role']) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() in ['teacher', 'admin', 'creator', 'owner'];
    }

    // Function to check if the user is an active assistant
    function isAssistant() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '').lower() == 'assistant' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('active', false) == true;
    }

    // 1. USERS COLLECTION
    match /users/{userId} {
      // Allow any logged in user to read and write (bypassing strict teacher check as requested)
      allow read, write: if request.auth != null;
    }

    // 2. ATTENDANCE RECORDS COLLECTION
    match /attendanceRecords/{recordId} {
      // Teachers can read, submit, edit, and delete all attendance records
      allow read, write: if isTeacher();
      
      // Assistants can read attendance and write new ones
      allow read: if isAssistant();
      allow write: if isAssistant();
      
      // Students can only read their OWN attendance records
      allow read: if request.auth != null && resource.data.studentID == request.auth.uid;
    }

    // 3. CLASSES COLLECTION
    match /classes/{classId} {
      // Teachers can manage (create, edit, delete) all classes
      allow read, write: if isTeacher();
      
      // Students and assistants can read all classes
      allow read: if request.auth != null;
    }

    // 4. GLOBAL SETTINGS COLLECTION
    match /globalSettings/{settingId} {
      // Teachers can toggle holidays and global active status
      allow read, write: if isTeacher();
      
      // Students can read the global settings to see if today is a holiday
      allow read: if request.auth != null;
    }
  }
}
